# ============================================================
# Flutter / Dart
# ============================================================

# Dart tool cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Pub
.pub-cache/
.pub/
pubspec.lock   # keep this commented out if you want reproducible builds
               # across CI – uncomment to ignore it for app projects

# Build outputs
/build/
/coverage/

# Widget Preview
.widget_preview/

# Dart generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# ============================================================
# Android
# ============================================================
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# Release keystores – NEVER commit these
*.jks
*.keystore
key.properties

# Android Studio build artefacts
/android/app/debug/
/android/app/profile/
/android/app/release/

